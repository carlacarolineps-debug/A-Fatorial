# Cabecalhos aplicados pelo Cloudflare Pages.
# Sao o minimo para um site publico: impedem que a pagina seja embutida em
# iframe de terceiros e que o navegador "adivinhe" o tipo de um arquivo.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# O sistema nao deve ser indexado nem guardado em cache de navegador:
# tem dado de gestao dentro.
/sistema/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
