# Copie este arquivo para .env e preencha. NUNCA suba o .env para o GitHub.

# --- Meta / WhatsApp Cloud API ---
# Painel: business.facebook.com -> Apps -> seu app -> WhatsApp -> Configuração da API
WHATSAPP_TOKEN=coloque_aqui_o_token_permanente
PHONE_ID=coloque_aqui_o_id_do_numero_remetente

# Template aprovado na Meta (categoria Utility) e idioma
TEMPLATE_NAME=nova_demanda
TEMPLATE_LANG=pt_BR

# 'template' = você inicia a conversa (caminho oficial, exige template aprovado)
# 'texto'    = mensagem livre com emoji e quebra de linha, só entrega dentro da
#              janela de 24h depois que a pessoa te respondeu
MENSAGEM_MODO=template

# --- Segurança ---
# Senha simples que o kanban manda no cabeçalho Authorization.
# É o mesmo valor do campo "Chave de acesso do servidor" na tela do sistema.
APP_TOKEN=troque_por_uma_senha_longa

# Endereços autorizados a chamar esta ponte (separados por vírgula).
# Vazio libera qualquer origem — use assim só em teste local.
ORIGENS=https://seusistema.com.br

PORT=3000

# Opcional: troca o endereço da API da Meta por um servidor de teste seu.
# Deixe vazio em produção.
# GRAPH_URL=http://localhost:4000
