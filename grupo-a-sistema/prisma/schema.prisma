// Grupo A! — schema de domínio.
//
// Reimplementação do Notion "Grupo A! | Organização | Produtividade | Foco".
// Os nomes de models, campos e enums são em português para manter o vínculo com
// o vocabulário que a equipe já usa. O `@map` de cada valor de enum guarda o
// rótulo EXATO que aparecia no Notion — é o que a migração usa para casar os
// valores e o que a UI exibe.
//
// Leia `CLAUDE.md` antes de mexer aqui: várias ausências são intencionais
// (não existe tabela `Resumo`, não existem propriedades `Etiqueta *`, não
// existem colunas `Total Janeiro`…`Total Dezembro`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum StatusCliente {
  ATIVO   @map("Ativo")
  INATIVO @map("Inativo")
}

enum FonteCliente {
  LINKEDIN @map("LinkedIn")
  SITE     @map("Site")
}

/// Canal do CRM novo (database `Leads`, 2e2fe715…).
enum CanalLead {
  INSTAGRAM @map("Instagram")
  WHATSAPP  @map("WhatsApp")
  INDICACAO @map("Indicação")
  // O rótulo no Notion está grafado "Linkedln" (com L). Preservado de propósito.
  LINKEDIN  @map("Linkedln")
  SITE      @map("Site")
  PARCEIROS @map("Parceiros")
  OUTROS    @map("Outros")
}

/// Fonte do CRM legado (database `Leads`, 29cfe715…8150).
enum FonteLeadLegado {
  WEBSITE   @map("Website")
  INSTAGRAM @map("Instagram")
  INDICACAO @map("Indicação")
  LINKEDIN  @map("LinkedIn")
}

/// As 6 etapas do funil do CRM novo.
enum EtapaLead {
  DESCOBERTA    @map("Descoberta")
  DIAGNOSTICO   @map("Diagnóstico")
  APRESENTACAO  @map("Apresentação")
  PROPOSTA      @map("Proposta")
  FOLLOW_UP     @map("Follow-up")
  FECHAMENTO    @map("Fechamento")
}

/// Vocabulário unificado dos dois CRMs. Ver docs/MAPA-NOTION.md §8 — a fusão de
/// `Convertido` e `Em conversação` (legado) é interpretação, não equivalência.
enum StatusLead {
  LEAD               @map("Lead")
  QUALIFICACAO       @map("Qualificação")
  NEGOCIACAO         @map("Negociação")
  PROPOSTA           @map("Proposta")
  FECHAMENTO_GANHO   @map("Fechamento Ganho")
  FECHAMENTO_PERDIDO @map("Fechamento Perdido")
}

enum StatusProjeto {
  NAO_INICIADO @map("Não iniciado")
  ONBOARDING   @map("Onboarding")
  PESQUISA     @map("Pesquisa")
  EM_ANDAMENTO @map("Em andamento")
  OFF_BOARDING @map("Off boarding")
  FEITO        @map("Feito")
}

enum TipoProjeto {
  WEBSITE   @map("Website")
  BRANDING  @map("Branding")
  MARKETING @map("Marketing")
  OUTROS    @map("Outros")
}

/// Unificação dos dois vocabulários de tarefa (principal + widget).
enum StatusTarefa {
  A_FAZER      @map("A fazer")
  EM_ANDAMENTO @map("Em andamento")
  COMPLETA     @map("Completa")
}

/// O widget usava "Alta 🔥"; a database principal usava "Alta". Unificados.
enum PrioridadeTarefa {
  BAIXA @map("Baixa")
  MEDIA @map("Média")
  ALTA  @map("Alta")
}

enum TagTarefa {
  FINANCEIRO @map("Financeiro")
  PROJETOS   @map("Projetos")
  VENDAS     @map("Vendas")
  MARKETING  @map("Marketing")
  OUTROS     @map("Outros")
}

/// De qual das duas databases de Tarefas o registro veio. Só serve para
/// rastreabilidade da migração — não use para lógica de negócio.
enum OrigemTarefa {
  PRINCIPAL @map("Tarefas")
  WIDGET    @map("Tarefas (widget)")
}

enum TipoFatura {
  PRECO_FIXO     @map("Preço fixo")
  PRECO_POR_HORA @map("Preço por hora")
}

enum StatusFatura {
  RASCUNHO @map("Rascunho")
  EMITIDA  @map("Emitida")
  PAGA     @map("Paga")
  VENCIDA  @map("Vencida")
}

/// Os 3 vocabulários do planner (Dia / Semana / Mês) colapsados em um só.
/// `Semana` usava "Em andamento" e `Mês` usava "Em progresso" — mesmo estado.
enum StatusPlanner {
  NAO_PLANEJADO @map("Não planejado")
  PLANEJADO     @map("Planejado")
  EM_ANDAMENTO  @map("Em andamento")
  CONCLUIDO     @map("Concluído")
}

enum PeriodoPlanner {
  DIA    @map("Dia")
  SEMANA @map("Semana")
  MES    @map("Mês")
}

enum StatusProposta {
  RASCUNHO @map("Rascunho")
  ENVIADA  @map("Enviada")
  ACEITA   @map("Aceita")
  RECUSADA @map("Recusada")
  EXPIRADA @map("Expirada")
}

enum StatusContrato {
  RASCUNHO   @map("Rascunho")
  EM_REVISAO @map("Em revisão")
  ASSINADO   @map("Assinado")
  ENCERRADO  @map("Encerrado")
  CANCELADO  @map("Cancelado")
}

enum StatusMeta {
  NAO_INICIADA @map("Não iniciada")
  EM_ANDAMENTO @map("Em andamento")
  ALCANCADA    @map("Alcançada")
  NAO_ALCANCADA @map("Não alcançada")
}

enum StatusPostagem {
  IDEIA      @map("Ideia")
  PRODUCAO   @map("Produção")
  AGENDADO   @map("Agendado")
  PUBLICADO  @map("Publicado")
}

enum PlataformaPostagem {
  INSTAGRAM @map("Instagram")
  LINKEDIN  @map("LinkedIn")
  FACEBOOK  @map("Facebook")
  TIKTOK    @map("TikTok")
  YOUTUBE   @map("YouTube")
  BLOG      @map("Blog")
}

enum StatusReuniao {
  AGENDADA  @map("Agendada")
  REALIZADA @map("Realizada")
  CANCELADA @map("Cancelada")
}

enum TipoReuniao {
  KICKOFF       @map("Kickoff")
  ACOMPANHAMENTO @map("Acompanhamento")
  APRESENTACAO  @map("Apresentação")
  ENCERRAMENTO  @map("Encerramento")
  INTERNA       @map("Interna")
}

enum StatusPortfolio {
  RASCUNHO  @map("Rascunho")
  PUBLICADO @map("Publicado")
  ARQUIVADO @map("Arquivado")
}

enum StatusEtapaSetup {
  NAO_INICIADA @map("Não iniciada")
  EM_ANDAMENTO @map("Em andamento")
  FEITA        @map("Feita")
}

enum FrequenciaHabito {
  DIARIO  @map("Diário")
  SEMANAL @map("Semanal")
}

enum RecorrenciaFinanceira {
  UNICO  @map("Único")
  MENSAL @map("Mensal")
  ANUAL  @map("Anual")
}

enum PapelUsuario {
  ADMIN       @map("Admin")
  GESTOR      @map("Gestor")
  COLABORADOR @map("Colaborador")
  CLIENTE     @map("Cliente")
}

/// Discriminador do anexo polimórfico (tabela `Arquivo`).
enum TipoEntidade {
  CLIENTE           @map("Cliente")
  PROJETO           @map("Projeto")
  TAREFA            @map("Tarefa")
  LEAD              @map("Lead")
  PROPOSTA          @map("Proposta")
  CONTRATO          @map("Contrato")
  FATURA            @map("Fatura")
  POSTAGEM          @map("Postagem")
  PROJETO_PORTFOLIO @map("Projeto de portfólio")
  REUNIAO           @map("Reunião")
  META              @map("Meta")
  PLANNER           @map("Planner")
}

enum TipoArquivo {
  CAPA  @map("Capa")
  PDF   @map("PDF")
  MIDIA @map("Mídia")
  OUTRO @map("Outro")
}

/// Fase da migração em que o registro entrou. Ver scripts/migrar-do-notion.ts.
enum FaseMigracao {
  FASE_1 @map("1 - independentes")
  FASE_2 @map("2 - dependentes")
  FASE_3 @map("3 - relações")
}

// ---------------------------------------------------------------------------
// Comercial
// ---------------------------------------------------------------------------

model Cliente {
  id             String        @id @default(cuid())
  nomeEmpresa    String
  contatoPessoal String?
  email          String?
  telefone       String?
  cnpj           String?
  cpf            String?
  endereco       String?
  cidade         String?
  uf             String?
  cep            String?
  status         StatusCliente @default(ATIVO)
  fonte          FonteCliente?
  ultimoProjeto  DateTime?     @db.Date
  capaUrl        String?
  criadoEm       DateTime      @default(now())
  atualizadoEm   DateTime      @updatedAt

  projetos  Projeto[]
  propostas Proposta[]
  contratos Contrato[]
  leads     Lead[]

  @@index([status])
  @@index([nomeEmpresa])
  @@map("clientes")
}

/// Fusão dos dois CRMs: `Leads` (novo, 6 etapas) + `Leads` (legado, 5 status).
model Lead {
  id             String           @id @default(cuid())
  nome           String
  contatoPessoal String?
  email          String?
  telefone       String?
  cnpj           String?
  endereco       String?
  etapa          EtapaLead?
  status         StatusLead       @default(LEAD)
  canal          CanalLead?
  /// Preenchido só nos registros vindos do CRM legado.
  fonteLegado    FonteLeadLegado?
  valorEstimado  Decimal?         @db.Decimal(12, 2)
  dataContato    DateTime?        @db.Date
  dataInicio     DateTime?        @db.Date
  dataFechamento DateTime?        @db.Date
  fechado        Boolean          @default(false)
  observacoes    String?
  criadoEm       DateTime         @default(now())
  atualizadoEm   DateTime         @updatedAt

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  tarefas   Tarefa[]
  propostas Proposta[]
  stats     LeadStat[]

  @@index([status])
  @@index([etapa])
  @@index([dataFechamento])
  @@map("leads")
}

/// Database `Stats` — indicadores agregados do funil, mantidos como registros
/// porque no Notion eram editados à mão.
model LeadStat {
  id           String   @id @default(cuid())
  rotulo       String
  valor        Decimal? @db.Decimal(12, 2)
  referencia   DateTime? @db.Date
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_stats")
}

model Proposta {
  id           String         @id @default(cuid())
  titulo       String
  status       StatusProposta @default(RASCUNHO)
  valor        Decimal?       @db.Decimal(12, 2)
  enviadaEm    DateTime?      @db.Date
  respondidaEm DateTime?      @db.Date
  validaAte    DateTime?      @db.Date
  observacoes  String?
  capaUrl      String?
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  projetos  Projeto[]
  contratos Contrato[]

  @@index([status])
  @@map("propostas")
}

model Contrato {
  id           String         @id @default(cuid())
  titulo       String
  status       StatusContrato @default(RASCUNHO)
  valor        Decimal?       @db.Decimal(12, 2)
  assinadoEm   DateTime?      @db.Date
  inicioVigencia DateTime?    @db.Date
  fimVigencia  DateTime?      @db.Date
  link         String?
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt

  clienteId  String?
  cliente    Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  propostaId String?
  proposta   Proposta? @relation(fields: [propostaId], references: [id], onDelete: SetNull)

  projetos Projeto[]

  @@index([status])
  @@map("contratos")
}

model Projeto {
  id           String        @id @default(cuid())
  nome         String
  status       StatusProjeto @default(NAO_INICIADO)
  tipos        TipoProjeto[]
  valor        Decimal?      @db.Decimal(12, 2)
  inicio       DateTime?     @db.Date
  termino      DateTime?     @db.Date
  link         String?
  texto        String?
  capaUrl      String?
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  clienteId  String?
  cliente    Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  propostaId String?
  proposta   Proposta? @relation(fields: [propostaId], references: [id], onDelete: SetNull)
  contratoId String?
  contrato   Contrato? @relation(fields: [contratoId], references: [id], onDelete: SetNull)

  tarefas   Tarefa[]
  faturas   Fatura[]
  reunioes  Reuniao[]
  feedbacks Feedback[]
  receitas  Receita[]

  @@index([status])
  @@index([clienteId])
  @@map("projetos")
}

/// Fusão de `Tarefas` (principal) + `Tarefas (widget)`.
model Tarefa {
  id           String            @id @default(cuid())
  titulo       String
  notas        String?
  status       StatusTarefa      @default(A_FAZER)
  prioridade   PrioridadeTarefa?
  tag          TagTarefa?
  prazo        DateTime?         @db.Date
  concluida    Boolean           @default(false)
  concluidaEm  DateTime?
  origem       OrigemTarefa      @default(PRINCIPAL)
  criadoEm     DateTime          @default(now())
  atualizadoEm DateTime          @updatedAt

  projetoId    String?
  projeto      Projeto?  @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  postagemId   String?
  postagem     Postagem? @relation(fields: [postagemId], references: [id], onDelete: SetNull)
  responsavelId String?
  responsavel  Usuario?  @relation(fields: [responsavelId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([prazo])
  @@index([projetoId])
  @@map("tarefas")
}

model Reuniao {
  id           String        @id @default(cuid())
  titulo       String
  tipo         TipoReuniao?
  status       StatusReuniao @default(AGENDADA)
  inicio       DateTime?
  fim          DateTime?
  local        String?
  pauta        String?
  notas        String?
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  projetoId String?
  projeto   Projeto? @relation(fields: [projetoId], references: [id], onDelete: SetNull)

  @@index([inicio])
  @@map("reunioes")
}

model Feedback {
  id           String   @id @default(cuid())
  titulo       String
  nota         Int?
  comentario   String?
  recebidoEm   DateTime? @db.Date
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  projetoId String?
  projeto   Projeto? @relation(fields: [projetoId], references: [id], onDelete: SetNull)

  @@map("feedbacks")
}

// ---------------------------------------------------------------------------
// Financeiro
// ---------------------------------------------------------------------------

model Fatura {
  id            String       @id @default(cuid())
  numero        String
  tipo          TipoFatura   @default(PRECO_FIXO)
  status        StatusFatura @default(EMITIDA)
  precoFixo     Decimal?     @db.Decimal(12, 2)
  emitidaEm     DateTime?    @db.Date
  dataEntrega   DateTime?    @db.Date
  pago          Boolean      @default(false)
  pagoEm        DateTime?    @db.Date
  pdfUrl        String?
  capaUrl       String?
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt

  projetoId String?
  projeto   Projeto? @relation(fields: [projetoId], references: [id], onDelete: SetNull)

  horas    PlanilhaHoras[]
  receitas Receita[]

  @@index([pago])
  @@index([dataEntrega])
  @@map("faturas")
}

model PlanilhaHoras {
  id           String   @id @default(cuid())
  descricao    String
  data         DateTime? @db.Date
  horas        Decimal  @default(0) @db.Decimal(8, 2)
  valorHora    Decimal? @db.Decimal(12, 2)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  faturaId String?
  fatura   Fatura? @relation(fields: [faturaId], references: [id], onDelete: SetNull)

  @@index([data])
  @@map("planilhas_horas")
}

model CategoriaReceita {
  id       String    @id @default(cuid())
  nome     String    @unique
  cor      String?
  criadoEm DateTime  @default(now())

  receitas Receita[]

  @@map("categorias_receita")
}

model CategoriaDespesa {
  id       String    @id @default(cuid())
  nome     String    @unique
  cor      String?
  criadoEm DateTime  @default(now())

  despesas Despesa[]

  @@map("categorias_despesa")
}

model Receita {
  id           String                 @id @default(cuid())
  descricao    String
  valor        Decimal                @db.Decimal(12, 2)
  data         DateTime               @db.Date
  recebido     Boolean                @default(false)
  recorrencia  RecorrenciaFinanceira  @default(UNICO)
  observacoes  String?
  criadoEm     DateTime               @default(now())
  atualizadoEm DateTime               @updatedAt

  categoriaId String?
  categoria   CategoriaReceita? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  mesId       String?
  mes         MesFinanceiro?    @relation(fields: [mesId], references: [id], onDelete: SetNull)
  projetoId   String?
  projeto     Projeto?          @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  faturaId    String?
  fatura      Fatura?           @relation(fields: [faturaId], references: [id], onDelete: SetNull)

  @@index([data])
  @@map("receitas")
}

model Despesa {
  id           String                @id @default(cuid())
  descricao    String
  valor        Decimal               @db.Decimal(12, 2)
  data         DateTime              @db.Date
  pago         Boolean               @default(false)
  recorrencia  RecorrenciaFinanceira @default(UNICO)
  observacoes  String?
  criadoEm     DateTime              @default(now())
  atualizadoEm DateTime              @updatedAt

  categoriaId String?
  categoria   CategoriaDespesa? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  mesId       String?
  mes         MesFinanceiro?    @relation(fields: [mesId], references: [id], onDelete: SetNull)

  @@index([data])
  @@map("despesas")
}

/// Database `Overview Financeiro` — uma linha por mês, com a meta de lucro.
/// As colunas `Total Janeiro`…`Total Dezembro` NÃO foram reproduzidas: use
/// `agruparPorMes()` em src/lib/formulas.ts ou um GROUP BY.
model MesFinanceiro {
  id           String   @id @default(cuid())
  nome         String
  ano          Int
  mes          Int
  metaLucro    Decimal? @db.Decimal(12, 2)
  moeda        String   @default("BRL")
  capaUrl      String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  metaAnualId String?
  metaAnual   MetaAnual? @relation(fields: [metaAnualId], references: [id], onDelete: SetNull)

  receitas Receita[]
  despesas Despesa[]

  @@unique([ano, mes])
  @@map("meses_financeiros")
}

/// Database `Meta anual`.
model MetaAnual {
  id           String   @id @default(cuid())
  nome         String
  ano          Int      @unique
  metaLucro    Decimal? @db.Decimal(12, 2)
  moeda        String   @default("BRL")
  texto        String?
  capaUrl      String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  meses MesFinanceiro[]

  @@map("metas_anuais")
}

// ---------------------------------------------------------------------------
// Planejamento
// ---------------------------------------------------------------------------

model Meta {
  id           String     @id @default(cuid())
  titulo       String
  descricao    String?
  status       StatusMeta @default(NAO_INICIADA)
  progresso    Int        @default(0)
  prazo        DateTime?  @db.Date
  concluidaEm  DateTime?  @db.Date
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt

  @@index([status])
  @@index([prazo])
  @@map("metas")
}

/// Databases `Dia`, `Semana` e `Mês` do planner, unificadas por `periodo`.
/// Os 3 vocabulários de status viraram o enum `StatusPlanner`.
model PlannerEntrada {
  id           String         @id @default(cuid())
  nome         String
  periodo      PeriodoPlanner
  status       StatusPlanner  @default(NAO_PLANEJADO)
  inicio       DateTime       @db.Date
  fim          DateTime?      @db.Date
  notas        String?
  capaUrl      String?
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt

  paiId String?
  pai   PlannerEntrada?  @relation("HierarquiaPlanner", fields: [paiId], references: [id], onDelete: SetNull)
  filhos PlannerEntrada[] @relation("HierarquiaPlanner")

  registrosHabito RegistroHabito[]

  @@unique([periodo, inicio])
  @@index([periodo, status])
  @@map("planner_entradas")
}

// ---------------------------------------------------------------------------
// Hábitos
//
// No Notion eram 5 checkboxes fixos (`Hábito 1`…`Hábito 5`) na database
// `Rastreador de hábitos`. Aqui viram registros: dá para ter quantos quiser e
// renomeá-los sem alterar o schema.
// ---------------------------------------------------------------------------

model Habito {
  id           String           @id @default(cuid())
  nome         String
  descricao    String?
  frequencia   FrequenciaHabito @default(DIARIO)
  ativo        Boolean          @default(true)
  ordem        Int              @default(0)
  cor          String?
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt

  marcacoes MarcacaoHabito[]

  @@map("habitos")
}

/// Uma linha do rastreador — no Notion, uma página com data + 5 checkboxes.
model RegistroHabito {
  id           String   @id @default(cuid())
  nome         String?
  data         DateTime @unique @db.Date
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  plannerSemanaId String?
  plannerSemana   PlannerEntrada? @relation(fields: [plannerSemanaId], references: [id], onDelete: SetNull)

  marcacoes MarcacaoHabito[]

  @@index([data])
  @@map("registros_habito")
}

model MarcacaoHabito {
  id      String  @id @default(cuid())
  feito   Boolean @default(false)
  anotacao String?

  habitoId  String
  habito    Habito         @relation(fields: [habitoId], references: [id], onDelete: Cascade)
  registroId String
  registro  RegistroHabito @relation(fields: [registroId], references: [id], onDelete: Cascade)

  @@unique([registroId, habitoId])
  @@map("marcacoes_habito")
}

// ---------------------------------------------------------------------------
// Conteúdo e operação
// ---------------------------------------------------------------------------

model Postagem {
  id           String              @id @default(cuid())
  titulo       String
  pauta        String?
  legenda      String?
  status       StatusPostagem      @default(IDEIA)
  plataformas  PlataformaPostagem[]
  agendadaPara DateTime?           @db.Date
  publicadaEm  DateTime?           @db.Date
  link         String?
  capaUrl      String?
  criadoEm     DateTime            @default(now())
  atualizadoEm DateTime            @updatedAt

  tarefas Tarefa[]

  @@index([status])
  @@index([agendadaPara])
  @@map("postagens")
}

model ProjetoPortfolio {
  id           String          @id @default(cuid())
  nome         String
  resumo       String?
  status       StatusPortfolio @default(RASCUNHO)
  publicadoEm  DateTime?       @db.Date
  link         String?
  capaUrl      String?
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt

  @@index([status])
  @@map("projetos_portfolio")
}

model EtapaSetup {
  id           String           @id @default(cuid())
  nome         String
  descricao    String?
  status       StatusEtapaSetup @default(NAO_INICIADA)
  ordem        Int              @default(0)
  concluidaEm  DateTime?        @db.Date
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt

  @@map("etapas_setup")
}

// ---------------------------------------------------------------------------
// Infra
// ---------------------------------------------------------------------------

/// Anexos polimórficos. O Notion espalhava props `Capa` / `PDF da Fatura` /
/// `Arquivos e mídia` por toda parte; aqui é uma tabela só.
/// Alguns models mantêm `capaUrl` como atalho para a capa principal — proposital.
model Arquivo {
  id           String       @id @default(cuid())
  nome         String
  url          String
  tipo         TipoArquivo  @default(OUTRO)
  mimeType     String?
  tamanhoBytes Int?
  tipoEntidade TipoEntidade
  entidadeId   String
  criadoEm     DateTime     @default(now())

  @@index([tipoEntidade, entidadeId])
  @@map("arquivos")
}

model Usuario {
  id           String       @id @default(cuid())
  nome         String
  email        String       @unique
  papel        PapelUsuario @default(COLABORADOR)
  ativo        Boolean      @default(true)
  avatarUrl    String?
  /// ID do usuário no Notion, para casar as props `Responsável` (type: person).
  notionUserId String?      @unique
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  tarefas Tarefa[]

  @@map("usuarios")
}

/// Torna a migração idempotente: mapeia o ID da página no Notion para o
/// registro local. Rodar `npm run migrar` duas vezes não duplica nada.
model NotionIdMap {
  id           String       @id @default(cuid())
  notionId     String       @unique
  entidade     String
  registroId   String
  dataSourceId String?
  fase         FaseMigracao
  importadoEm  DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  @@index([entidade, registroId])
  @@map("notion_id_map")
}

/// Chave/valor para ajustes da aplicação (substitui a database `Configurações`).
model Configuracao {
  chave        String   @id
  valor        String
  descricao    String?
  atualizadoEm DateTime @updatedAt

  @@map("configuracoes")
}
