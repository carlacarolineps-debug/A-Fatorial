# Postgres — local via Docker:
#   docker run -d --name grupoa-db -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:16
DATABASE_URL="postgresql://postgres:dev@localhost:5432/grupoa?schema=public"

# Notion — só necessário para rodar a migração inicial.
# Crie em https://www.notion.so/my-integrations e depois compartilhe a página
# raiz com a integração (⋯ → Conexões → sua integração), senão a API dá 404.
NOTION_TOKEN="ntn_xxxxxxxxxxxxxxxxxxxx"
